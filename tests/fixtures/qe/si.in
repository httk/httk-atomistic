&control
   calculation = 'scf'
   prefix      = 'si'
   outdir      = './tmp'
   pseudo_dir  = './'
/
&system
   ibrav     = 2
   celldm(1) = 10.26
   nat       = 2
   ntyp      = 1
   ecutwfc   = 12
/
&electrons
   conv_thr = 1.0d-8
/
ATOMIC_SPECIES
 Si  28.085  Si.upf
ATOMIC_POSITIONS crystal
 Si 0.00 0.00 0.00
 Si 0.25 0.25 0.25
K_POINTS automatic
 2 2 2 0 0 0
