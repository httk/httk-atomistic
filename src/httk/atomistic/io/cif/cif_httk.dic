#\#CIF_2.0
##############################################################################
#                                                                            #
#  CIF_HTTK: the httk dictionary of local CIF data names                     #
#                                                                            #
#  Data names that httk (the high-throughput toolkit, httk-atomistic) reads  #
#  and writes besides those of the CIF core dictionary: exact companions of  #
#  cell parameters, coordinates and occupancies, and the bond network        #
#  extras (the count of a known-empty network, the bond source, the shape of #
#  each site and the shape source). The bonds themselves are the core        #
#  _geom_bond_ items.                                                        #
#                                                                            #
#  Naming convention. The CIF1 data names httk writes start with the local   #
#  prefix: _httk_<category>_<object>, for example                            #
#  _httk_atom_site_fract_x_exact and _httk_shape_symbol. The IUCr reserved-  #
#  prefix rule is stated for such CIF1 names. The DDLm definitions place the #
#  prefix as the wwPDB PDBx/mmCIF dictionary does in DDL2 (_atom_site.pdbx_* #
#  and _pdbx_* categories), a practice borrowed here, not an IUCr DDLm rule: #
#  a NEW category carries the prefix in its category name                    #
#  (_httk_shape.symbol, category HTTK_SHAPE), and an item ADDED to an        #
#  existing core category carries it at the start of its object name         #
#  (_cell.httk_length_a_exact, category CELL), so that it can share the core #
#  loop or set. Such DDLm ids do not start with the prefix, which is why     #
#  every item gives the CIF1 name as _alias.definition_id. COMCIFS DDLm      #
#  extensions such as cif_ms and cif_pow normally define their own prefixed  #
#  categories instead. The frame structure follows cif_core.dic and          #
#  cif_ms.dic of COMCIFS (https://github.com/COMCIFS). This convention is    #
#  unverified against the IUCr register of reserved prefixes, whose pages    #
#  could not be fetched; whether 'httk' is registered is for the maintainer  #
#  to confirm.                                                               #
#                                                                            #
##############################################################################

data_CIF_HTTK

    _dictionary.title             CIF_HTTK
    _dictionary.class             Instance
    _dictionary.version           1.0.0
    _dictionary.date              2026-11-14
    _dictionary.uri               https://schemas.httk.org/cif/cif_httk.dic
    _dictionary.ddl_conformance   4.2.0
    _dictionary.namespace         CifCore
    _description.text
;
    Local data names of httk: exact companions of standard numeric items and
    the bond network items (network count, bond source, site shapes and shape
    source) that accompany the core _geom_bond_ loop.
;

save_CIF_HTTK_HEAD

    _definition.id                CIF_HTTK_HEAD
    _definition.scope             Category
    _definition.class             Head
    _definition.update            2026-11-14
    _description.text
;
    The head category of the httk local data names.
;
    _name.category_id             CIF_HTTK
    _name.object_id               CIF_HTTK_HEAD

    _import.get
        [
         {'dupl':Ignore  'file':cif_core.dic  'mode':Full
          'save':CIF_CORE_HEAD}
        ]

save_

save_cell.httk_length_a_exact

    _definition.id                '_cell.httk_length_a_exact'
    _alias.definition_id          '_httk_cell_length_a_exact'
    _definition.update            2026-11-14
    _description.text
;
    The exact value of the cell length a as a rational number, written when
    the standard decimal of _cell.length_a cannot state it exactly, for
    example 1/3. It is a decimal or a fraction p/q of integers. A reader
    that knows this item takes it instead of _cell.length_a; any other
    reader uses _cell.length_a.
;
    _name.category_id             cell
    _name.object_id               httk_length_a_exact
    _type.purpose                 Encode
    _type.source                  Derived
    _type.container               Single
    _type.contents                Text

save_

