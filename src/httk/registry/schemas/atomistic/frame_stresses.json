                },
                {
                    "relation": "Redefinition of the kilogram at the 26th CGPM Meeting (2018), resolution 1",
                    "resource-id": "https://www.bipm.org/en/committees/cg/cgpm/26-2018/resolution-1"
                }
            ],
            "defining-relation": {
                "base-units": [
                    {
