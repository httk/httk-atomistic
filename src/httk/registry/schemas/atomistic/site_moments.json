                "dim_spatial"
            ],
            "sizes": [
                3
            ]
        },
        "items": {
            "x-optimade-type": "float",
            "x-optimade-unit": "bohrmagneton",
            "type": [
                "number"
            ]
        }
    },
    "examples": [
        [
            [
                0.0,
                0.0,
                2.0
